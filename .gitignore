# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

#AI
*.md

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — şablon hariç (gerçek .env asla commit edilmez, MASTER_KEY içerir)
.env*
!.env.example

# panel verisi (M0.3'te gelecek volume: sqlite.db, migration kopyaları, logolar)
/data/

# host script'lerinin bıraktığı raporlar (M1.4 S.M.A.R.T/ZFS) — sunucuya özgü
/reports/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
