# Dağıtım parametreleri (T9). Panelden değiştirilebilen her şey Ayarlar
# ekranından yönetilir ve veritabanında tutulur — buraya eklenmez.

# MOCK_MODE (T10): 1 yapıldığında dış dünyaya dokunan tüm sağlayıcılar
# fixtures/ altındaki sabit veriyi döndürür. Windows'ta yerel geliştirme ve
# sunucuda sorun ayıklama için.
MOCK_MODE=0

# Panel sürümü (imaja gömülür, /api/health ve sol alt köşede görünür)
APP_VERSION=1.9.0

# Caddy'nin host'ta bağlandığı portlar. Panel container'ı dışarıya port açmaz;
# tek giriş noktası Caddy'dir. Sunucuda dolu olmayan portlar seç.
#
#   PANEL_HTTP_PORT  → PANELİN KENDİSİ. Adres: http://<sunucu>:<port>
#                      Panelden yayınlanan, TLS'i kapalı siteler de buradan
#                      sunulur.
#   PANEL_HTTPS_PORT → yalnızca panelden YAYINLANAN siteler TLS kullanıyorsa
#                      gerekli (Ayarlar → Proxy & DDNS). Panel bu portta
#                      SUNULMAZ.
#
# ⚠️ Panel M3.45'ten beri düz HTTP: yerel CA'lı sertifika hiçbir cihazda
#    tanınmadığı için her ziyarette tarayıcı uyarısı çıkarıyor, karşılığında
#    yerel ağda gerçek bir koruma sağlamıyordu. Trafik (parola, oturum çerezi,
#    web terminal) ŞİFRESİZ taşınır — paneli internete açma.
#
# Portsuz adres istiyorsan (ör. http://sunucu) bunu 80 yap — host'ta o portu
# dinleyen başka bir şey olmamalı:
#   ss -lntp | grep -E ':(80|443) '
PANEL_HTTP_PORT=8080
PANEL_HTTPS_PORT=8443

# Panelin dinleyeceği adresler (virgülle ayrılır). BOŞ BIRAKILABİLİR:
# varsayılan `:80`, yani hangi IP ya da host adıyla gelinirse gelinsin panel
# açılır. Adresleri tek tek saymak yalnızca TLS varken zorunluydu (sertifika
# hangi isim için üretilecek); TLS kalkınca o zorunluluk da kalktı.
#
# Yine de sınırlamak istersen şema HTTP olmalı ve satırın başındaki # kalkmalı.
# BOŞ BIRAKMA, satırı tamamen yorumda bırak: boş bir değer Caddy'ye "adres
# yok" diye gider ve varsayılan devreye girmez.
#PANEL_SITE_ADDRESSES=http://192.168.61.114, http://sunucu.local

TZ=Europe/Istanbul

# Host'un docker grubunun GID'i. Panel root olmayan bir kullanıcıyla çalışıyor;
# docker.sock'u okuyabilmesi için bu gruba eklenmesi gerekiyor (M1.2 container
# monitörü, M1.6 Docker yönetimi). Sunucuda öğrenmek için:
#   getent group docker | cut -d: -f3
DOCKER_GID=999

# Panel container'ının alt ağı. Sabit tutuluyor çünkü container'dan host'un
# kendi portlarına erişimi açan ufw kuralı bu alt ağa göre yazılıyor; Docker
# kendiliğinden atarsa ağ yeniden oluşturulduğunda değişip kuralı sessizce
# işlevsiz bırakabilir. Sunucudaki başka bir ağla çakışıyorsa değiştir:
#   docker network ls --format '{{.Name}}' | xargs -I{} docker network inspect {} \
#     --format '{{.Name}} {{range .IPAM.Config}}{{.Subnet}}{{end}}'
PANEL_SUBNET=172.28.0.0/16

# Panel verisinin dizini (sqlite.db + migration öncesi kopyalar).
# Container içinde /app/data'dır ve volume olarak bağlanır.
# DATA_DIR=/app/data

# T3 — AES-256-GCM secret şifreleme anahtarı. ZORUNLU; yoksa panel açılmaz.
# Üretmek için:  openssl rand -hex 32
# Panel dışında AYRI bir yerde de sakla — yedeğe bilinçli olarak girmez,
# kaybedersen şifreli ayarlar (token'lar, parolalar) geri getirilemez.
MASTER_KEY=

# İlk kurulumda oluşturulacak yönetici. ADMIN_PASSWORD boş bırakılırsa
# rastgele üretilip container loguna yazılır. Her iki durumda da ilk girişte
# parola değiştirilmesi istenir.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- M1.13'te eklenecek ---
# HELPER_SECRET=         # host-helper HMAC paylaşılan sırrı (T4).
#                        # Komut whitelist'i burada DEĞİL — host tarafında,
#                        # /etc/panel-helper/allow.conf içinde durur.

# --- Çoklu sunucu: panel-agent ---
# Aynı imaj uzak sunucuda ajan olarak çalışır. Kurulum dosyalarını panel
# üretir (Sunucular → Sunucu ekle); aşağıdakiler yalnızca başvuru içindir.
# PANEL_ROLE=agent        # merkez için boş bırakın
# AGENT_TOKEN=            # panelin bir kez gösterdiği anahtar
# AGENT_PORT=7443         # ajanın HTTPS portu
# AGENT_BIND=0.0.0.0      # yalnızca LAN/Tailscale adresine bağlamak daha güvenli
#
# Merkez: kurulum metnindeki ajan imajı (varsayılan: bu sürümün GHCR etiketi).
# AGENT_IMAGE=ghcr.io/coraspirin/servermanagementpanel:1.9.0
